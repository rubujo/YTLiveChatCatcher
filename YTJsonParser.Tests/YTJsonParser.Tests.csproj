  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YTJsonParser\YTJsonParser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
